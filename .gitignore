# Ignore node_modules in all subdirectories
**/node_modules/

# Ignore environment variables
**/.env

# Ignore local logs, coverage, debug, and OS files
**/logs/
**/*.log
**/*.local
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/coverage/
**/.DS_Store
**/.vscode/
**/.idea/

# Ignore build artifacts
**/dist/
**/build/

# Ignore Postman environment files if local
*.postman_environment.json

# Ignore OS/system files
Thumbs.db
ehthumbs.db